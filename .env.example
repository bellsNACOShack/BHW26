# ==============================================================================
# Interlog Backend Environment Variables
# ==============================================================================

# Supabase Configuration
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# JWT Secret for backend authentication tokens
JWT_SECRET=super-secret-jwt-key-change-this-in-production

# App / Deployment URL (used for WebAuthn passkey origin & verification redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000
